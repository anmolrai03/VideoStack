PORT=3000

# Toggle between development and production by changing NODE_ENV:
# - development: connects to local Redis (127.0.0.1:6379) and local Mongo
# - production: connects to online providers (Upstash REDIS_URL with TLS & MongoDB Atlas)
NODE_ENV=development

CORS_ORIGIN=http://localhost:5173

MONGODB_URL=paste_your_connection_url_here

JWT_SECRET_KEY=your_secret_key

REDIS_HOST=
REDIS_PORT=
REDIS_URL=your_upstash_redis_url

# Set to true during load testing to bypass Cloudinary API and avoid quota exhaustion
SKIP_CLOUD_UPLOAD=false

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

CDN_URL=