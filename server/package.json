{
  "name": "server",
  "version": "1.0.0",
  "description": "Video Stream and Processing server",
  "license": "ISC",
  "author": "Anmol Rai",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "test": "vitest",
    "dev": "nodemon server.js",
    "dev:workers": "nodemon workers/index.js",
    "start": "node server.js",
    "start:workers": "node workers/index.js",
    "redis:start": "docker start redis-dev || docker run -d -p 6379:6379 --name redis-dev redis:7",
    "redis:stop": "docker stop redis-dev",
    "dev:all": "npm run redis:start && concurrently -k --names \"SERVER,WORKER\" --prefix-colors \"red,yellow\" \"npm run dev\" \"npm run dev:workers\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.67.3",
    "cloudinary": "^2.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.1.5",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^9.2.1",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2",
    "vitest": "^4.0.18"
  }
}
